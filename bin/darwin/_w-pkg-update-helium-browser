#!/usr/bin/env bash
# shellcheck disable=SC1090

set -o pipefail  # propagate errors
set -u  # exit on undefined
set -e  # exit on non-zero return value
#set -f  # disable globbing/filename expansion
shopt -s failglob  # error on unexpaned globs

echo -e '\n--------\nhelium-browser version check\n'  >&2

upstream_latest_tag="$(curl -s -L https://api.github.com/repos/imputnet/helium-macos/releases/latest | jq -r .name)"

installed_version="$(/Applications/Helium.app/Contents/MacOS/Helium --version | awk '{ print $2 }')"

if [ "$installed_version" != "$upstream_latest_tag" ]; then
  echo "[!] Helium Browser version does not match upstream. $installed_version < $upstream_latest_tag."
  osascript -e 'display notification "Update required" with title "_w-pkg-update-alacritty" subtitle "Helium"'
else
  echo "[.] Helium Browser up-to-date."
fi

